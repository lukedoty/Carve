:root {
}

.button {
    font-size: 45px;
    width: 600px;
    height: 182.2px;
    justify-content: center;
    align-self: center;
    background-image: url("project://database/Assets/Art%20Assets/2D/UI/MainMenu/Long%20Buttons%20-%203.png?fileID=2800000&guid=a111656e076bc424eb2e0c5d1b1fa151&type=3#Long Buttons - 3");
    color: rgb(255, 255, 255);
    top: auto;
    bottom: auto;
    background-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    -unity-font-definition: url("project://database/Assets/Art%20Assets/2D/UI/Kalam-Regular.ttf?fileID=12800000&guid=dbf5b4227463e44c9b18f8ff8a8a3f02&type=3#Kalam-Regular");
    -unity-font-style: bold;
    align-content: center;
    align-items: center;
}
